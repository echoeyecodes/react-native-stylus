{
  "compilerOptions": {
    "strict": true,
    "target": "ES2023",
    "lib": [
      "ES2023"
    ],
    "declaration": true,
    "sourceMap": true,
    "rootDir": "src",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  }
}

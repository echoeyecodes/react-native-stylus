{
  "name": "react-native-stylus",
  "version": "0.1.1",
  "description": "Point at any element in your running React Native app, say what to change, and watch it update.",
  "keywords": [
    "react-native",
    "expo",
    "metro",
    "claude-code",
    "codex",
    "ai",
    "developer-tools"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/echoeyecodes/react-native-stylus.git",
    "directory": "packages/react-native-stylus"
  },
  "homepage": "https://github.com/echoeyecodes/react-native-stylus#readme",
  "bugs": {
    "url": "https://github.com/echoeyecodes/react-native-stylus/issues"
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/native/runtime/stylus.d.ts",
      "default": "./dist/native/runtime/stylus.js"
    },
    "./metro": {
      "types": "./dist/node/metro/with-stylus.d.ts",
      "default": "./dist/node/metro/with-stylus.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.runtime.json && tsc -p tsconfig.metro.json",
    "dev": "tsc -p tsconfig.runtime.json --watch --preserveWatchOutput & tsc -p tsconfig.metro.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.runtime.json --noEmit && tsc -p tsconfig.metro.json --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-safe-area-context": "*",
    "react-native-svg": "*",
    "react-native-view-shot": "*"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^2.10.0",
    "@anthropic-ai/claude-agent-sdk": "^0.3.325",
    "diff": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "~19.3.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0",
    "react-native-view-shot": "6.1.1",
    "typescript": "~6.0.3"
  }
}

{
  "name": "react-native-stylus",
  "version": "0.1.0",
  "description": "Point at any element in your running React Native app, say what to change, and watch it update.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/native/runtime/stylus.d.ts",
      "default": "./dist/native/runtime/stylus.js"
    },
    "./metro": {
      "types": "./dist/node/metro/with-stylus.d.ts",
      "default": "./dist/node/metro/with-stylus.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.runtime.json && tsc -p tsconfig.metro.json",
    "dev": "tsc -p tsconfig.runtime.json --watch --preserveWatchOutput & tsc -p tsconfig.metro.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.runtime.json --noEmit && tsc -p tsconfig.metro.json --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-safe-area-context": "*",
    "react-native-view-shot": "*"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.325"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "~19.3.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-view-shot": "6.1.1",
    "typescript": "~6.0.3"
  }
}
